{
  "name": "hverdagens-app",
  "version": "1.0.0",
  "description": "Hverdagens app til Windows",
  "author": "Hverdagens app",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:build": "electron-builder --win nsis",
    "mobile:prepare": "node scripts/prepare-mobile.mjs",
    "mobile:sync": "npm run mobile:prepare && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/camera": "8.0.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dk.valde3713.hverdagensapp",
    "productName": "Hverdagens app",
    "asar": true,
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/loading.html",
      "desktop/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "hverdagens-app-setup.exe",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
