    - name: Byg Xcode Projekt (Uden certifikater)
      run: |
        cd ios/App
        xcodebuild ARCHS=arm64 -workspace App.xcworkspace -scheme App -configuration Release -sdk iphoneos CODE_SIGN_ING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" PROVISIONING_PROFILE_REQUIRED=NO clean build

    - name: Pak Xcode .app til iOS .ipa
      run: |
        mkdir -p Payload
        cp -r ios/App/build/Release-iphoneos/App.app Payload/ 2>/dev/null || cp -r ~/Library/Developer/Xcode/DerivedData/*/Build/Products/Release-iphoneos/App.app Payload/
        zip -r HverdagensApp.ipa Payload
